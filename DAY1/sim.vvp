L_0x609ca816a910 .functor MUXZ 8, v0x609ca816a670_0, v0x609ca816a590_0, v0x609ca816a740_0, C4<>;
    .scope S_0x609ca8156280;
T_0 ;
    %fork t_1, S_0x609ca811c490;
    %jmp t_0;
    .scope S_0x609ca811c490;
t_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x609ca811c670_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x609ca811c670_0;
    %cmpi/s 10, 0, 32;
    %jmp/0xz T_0.1, 5;
    %vpi_func 3 14 "$urandom_range" 32, 32'sb00000000000000000000000000000000, 8'b11111111 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x609ca816a590_0, 0, 8;
    %vpi_func 3 15 "$urandom_range" 32, 32'sb00000000000000000000000000000000, 8'b11111111 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x609ca816a670_0, 0, 8;
    %vpi_func 3 16 "$random" 32 {0 0 0};
    %pushi/vec4 2, 0, 32;
    %mod/s;
    %pad/s 1;
    %store/vec4 v0x609ca816a740_0, 0, 1;
    %delay 5, 0;
    ; show_stmt_assign_vector: Get l-value for compressed += operand
    %load/vec4 v0x609ca811c670_0;
    %pushi/vec4 1, 0, 32;
    %add;
    %cast2;
    %store/vec4 v0x609ca811c670_0, 0, 32;
